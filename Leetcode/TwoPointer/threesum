class Solution:
    def threeSum(self, nums: list[int]) -> list[list[int]]:
        if not nums:
            return []
        n = len(nums)
        nums.sort()
        res = []
        l = 1
        r = n - 1

        for i in range(n - 2):
            if i != 0 and nums[i] == nums[i - 1]:
                continue
            po = -nums[i]
            l = i + 1
            r = n - 1

            while l < r:
                cur = nums[l] + nums[r]
                if l < r and cur < po:
                    l += 1
                    cur = nums[l] + nums[r]
                elif l < r and cur > po:
                    r -= 1
                    cur = nums[l] + nums[r]
                elif cur == po:
                    res.append([nums[i], nums[l], nums[r]])
                    while l < r and nums[l] == nums[l + 1]:
                        l += 1
                    while l < r and nums[r] == nums[r - 1]:
                        r -= 1
                    l += 1
                    r -= 1
        return res
